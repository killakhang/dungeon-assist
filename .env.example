DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Local AI (default): Ollama on the same machine
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:0.5b

# Optional fallback if local Ollama is unavailable
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

DUNGEON_DB=dungeon_assist.db

# Public HTTPS address for the browser tabletop, e.g. https://vtt.example.com
PUBLIC_VTT_URL=
VTT_HOST=0.0.0.0
VTT_PORT=8000
